DATABASE_URL="postgresql://lhl76:lhl76@localhost:5432/lhl76?schema=public"
AUTH_SECRET="change-this-to-a-long-random-secret"
PUBLIC_SITE_URL="https://lhl-76.ru"
# Absolute server path to restored public-files (compose only).
MEDIA_ROOT="/srv/lhl76/public-files"
# Разрешать только на время создания первого администратора в новой пустой базе.
ALLOW_ADMIN_SETUP="0"
# Только если доверенный reverse proxy ПЕРЕЗАПИСЫВАЕТ X-Real-IP.
TRUST_PROXY_IP="0"
# Общий каталог ограничений для процессов на одном сервере; не размещать в public.
RATE_LIMIT_DIR=".runtime/limits"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"
VK_VIDEO_CHANNEL_URL="https://vkvideo.ru/@lhl76/lives"
VK_API_ACCESS_TOKEN=""
## Для фотоальбомов VK используется тот же серверный токен VK_API_ACCESS_TOKEN.
# Необязательно: отрицательный ID сообщества VK, если имя канала не разрешается через API.
VK_VIDEO_OWNER_ID=""
SENTRY_DSN=""
BACKUP_RETENTION_DAYS="14"
